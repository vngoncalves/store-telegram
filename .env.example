# Copie este arquivo para ".env" (na mesma pasta do store_bot.py) e preencha.
# NUNCA envie o .env para o GitHub nem o coloque dentro de um .zip no repositório.

# Telegram
BOT_TOKEN=TOKEN_DO_BOTFATHER
ADMIN_IDS=SEU_ID_TELEGRAM
SUPPORT_USERNAME=usuario_suporte
# Opcional: canal exibido no menu principal (sem @)
STORE_CHANNEL=

# Opcional: imagem do menu inicial (link direto). Também pode ser definida no painel admin.
HOME_IMAGE_URL=

# Opcional: canal de logs (ex.: -1001234567890). Também pode ser definido no painel admin.
LOG_CHANNEL_ID=

# Arquivos de dados (relativos à pasta do bot)
DATA_FILE=data/store.json
PRODUCTS_FILE=produtos.json
POLLING_TIMEOUT=30

# ROASClub (página "Credenciais API")
ROASCLUB_PUBLIC_KEY=sua_chave_publica
ROASCLUB_SECRET_KEY=sua_chave_secreta

# Pagador informado em todas as cobranças Pix. Use dados reais e confirme com a
# ROASClub que esse cadastro padrão é permitido. Sem isso a recarga Pix fica desativada.
ROASCLUB_CUSTOMER_NAME=Nome Sobrenome
ROASCLUB_CUSTOMER_EMAIL=financeiro@sualoja.com
ROASCLUB_CUSTOMER_CPF=00000000000
ROASCLUB_CUSTOMER_PHONE=11999998888
